<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - U_Tech</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/U_Tech.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var rol = Context.Session.GetString("Rol");
        }

        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">

            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">U-Tech</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        @if (rol == "Personal")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Recepcionista" asp-action="Index">🏠 Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Recepcionista" asp-action="RegistrarCliente">👤 Registrar Cliente</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Recepcionista" asp-action="RegistrarPC">💻 Registrar PC</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Recepcionista" asp-action="CrearSolicitud">📄 Crear Solicitud</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Recepcionista" asp-action="SolicitudesDiagnosticadas">📦 Entregas / Decisión Cliente</a></li>
                        }

                        @if (rol == "Tecnico")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Tecnico" asp-action="Index">🛠 Mis Solicitudes</a></li>
                        }

                        @if (rol == "GerenteSucursal")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Gerente" asp-action="Index">🏢 Panel Gerente</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Gerente" asp-action="EstadoSucursal">📊 Estado General</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Gerente" asp-action="PersonalSucursal">👥 Personal</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Gerente" asp-action="ReportesSucursal">📈 Rendimiento</a></li>
                        }

                        @if (rol == "Administrador")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">🌍 Admin Global</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="GestionSucursales">🏢 Sucursales</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="GestionUsuarios">👥 Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="VerExpedientes">📚 Expedientes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="ReportesGlobales">📊 Reportes Globales</a></li>
                        }

                    </ul>

                    @if (!string.IsNullOrEmpty(rol))
                    {
                        <span class="navbar-text text-white me-3">Rol: @rol</span>
                        <a class="btn btn-danger" asp-controller="Login" asp-action="Logout">Cerrar Sesión</a>
                    }
                </div>
            </div>
        </nav>

    </header>
    <main role="main" class="pb-3 flex-grow-1">
        <div class="container">
            <div class="main-content-card">
                @RenderBody()
            </div>
        </div>
    </main>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - U_Tech - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
