@model System.Data.DataTable

@section Styles {
    <style>
        .form-card {
            max-width: 1000px;
            margin: 20px auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 25px 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

            .form-card h2 {
                text-align: center;
                font-weight: 700;
                margin-bottom: 20px;
            }

        .btn-small {
            padding: 5px 10px;
            font-size: 0.8rem;
        }

        #table-wrapper {
            overflow-x: auto;
        }

        table.table {
            min-width: 750px;
        }
    </style>
}

@functions {
    // Helper seguro para evitar excepciones por columnas inexistentes
    private string SafeGet(System.Data.DataRow row, string column)
    {
        if (row.Table.Columns.Contains(column))
        {
            var v = row[column];
            return (v != null && v != System.DBNull.Value) ? v.ToString() : "";
        }
        return "";
    }
}

<div class="form-card">

    <h2>Solicitudes Pendientes</h2>

    <div id="table-wrapper">

        <table class="table table-striped table-bordered mt-2">
            <thead>
                <tr>
                    <th>ID Solicitud</th>
                    <th>Cliente</th>
                    <th>Computadora</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (System.Data.DataRow row in Model.Rows)
                    {
                        // Valores seguros
                        var id = SafeGet(row, "Solicitud_ID");
                        var cliente = SafeGet(row, "Cliente");
                        var pc = SafeGet(row, "PC_ID");
                        var estado = SafeGet(row, "Estado");
                        var fecha = SafeGet(row, "Fecha");

                        <tr>
                            <td>@id</td>
                            <td>@cliente</td>
                            <td>@pc</td>
                            <td>@estado</td>
                            <td>@fecha</td>

                            <td>
                                @if (!string.IsNullOrEmpty(id))
                                {
                                    <a asp-action="Diagnosticar"
                                       asp-route-id="@id"
                                       class="btn btn-primary btn-sm">
                                        Diagnosticar
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Sin ID</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No hay solicitudes pendientes.
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

    <div class="mt-3 text-center">
        <a asp-controller="Tecnico" asp-action="EnReparacion"
           class="btn btn-warning btn-small">
            Ver Solicitudes en Reparación
        </a>
    </div>

</div>
