@{
    ViewData["Title"] = "Registrar Reparación";
}

<h2>Registrar Reparación</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="GuardarReparacion" method="post">
    <input type="hidden" name="Solicitud_ID" value="@ViewBag.SolicitudID" />

    <div class="mb-3">
        <label>Detalle del trabajo</label>
        <textarea name="Detalle" class="form-control" required rows="5">@ViewBag.Detalle</textarea>
    </div>

    <div class="mb-3">
        <label>Costo Final</label>
        <input type="number" step="0.01" min="0.01" name="Costo" class="form-control"
               value="@ViewBag.Costo" required>
    </div>

    <button type="submit" class="btn btn-primary mt-3" id="btnGuardar">Guardar Reparación</button>
</form>

<a href="/Tecnico" class="btn btn-secondary mt-3">Volver</a>


@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function () {
            var btn = document.getElementById('btnGuardar');
            btn.disabled = true;
            btn.innerHTML = 'Guardando...';
        });
    </script>
}