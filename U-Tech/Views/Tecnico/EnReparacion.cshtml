@model System.Data.DataTable

@section Styles {
    <style>
        .form-card {
            max-width: 1000px;
            margin: 20px auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 25px 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

            .form-card h2 {
                text-align: center;
                font-weight: 700;
                margin-bottom: 20px;
            }

        .btn-small {
            padding: 5px 10px;
            font-size: 0.8rem;
        }

        #table-wrapper {
            overflow-x: auto;
        }

        table.table {
            min-width: 800px;
        }
    </style>
}

@functions {
    // Helper seguro: evita errores de columnas inexistentes
    private string SafeGet(System.Data.DataRow row, string column)
    {
        if (row.Table.Columns.Contains(column))
        {
            var v = row[column];
            return (v != null && v != System.DBNull.Value) ? v.ToString() : "";
        }
        return "";
    }
}

<div class="form-card">

    <h2>Solicitudes en Reparación</h2>

    <div class="text-center mb-3">
        <a asp-controller="Tecnico" asp-action="Index" class="btn btn-secondary btn-small">
            Volver a Solicitudes Pendientes
        </a>
    </div>

    <div id="table-wrapper">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Solicitud</th>
                    <th>Cliente</th>
                    <th>Computadora</th>
                    <th>Técnico que recibió</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (System.Data.DataRow row in Model.Rows)
                    {
                        var id = SafeGet(row, "Solicitud_ID");
                        var cliente = SafeGet(row, "Nombre_Cliente");
                        var marca = SafeGet(row, "Marca_PC");
                        var tipo = SafeGet(row, "Tipo_computadora");
                        var tecnico = SafeGet(row, "Personal_que_recibio");

                        <tr>
                            <td>@id</td>
                            <td>@cliente</td>
                            <td>@marca - @tipo</td>
                            <td>@tecnico</td>

                            <td>
                                <a asp-action="Reparar"
                                   asp-route-id="@id"
                                   class="btn btn-success btn-sm">
                                    Registrar Reparación
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay solicitudes en reparación.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
