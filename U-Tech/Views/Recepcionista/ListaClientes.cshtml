@section Styles {
    <style>
        .form-card {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 25px 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

            .form-card h2 {
                text-align: center;
                font-weight: 700;
                margin-bottom: 20px;
            }

        #buscador {
            max-width: 300px;
            margin: 0 auto 20px auto;
        }

        .btn-volver-small {
            padding: 4px 10px;
            font-size: 0.85rem;
        }
    </style>
}

<div class="form-card">

    <h2>Seleccionar Cliente</h2>

    <!-- Botón Volver pequeño -->
    <div class="d-flex">
        <a href="/Recepcionista/RegistrarPC" class="btn btn-secondary btn-volver-small">Volver</a>
    </div>

    <!-- Buscador -->
    <input type="text" id="buscador" placeholder="Buscar cliente..."
           class="form-control" />

    <!-- Tabla -->
    <table class="table table-striped table-bordered mt-3">
        <thead>
            <tr>
                <th>Cliente ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acción</th>
            </tr>
        </thead>

        <tbody id="tabla">
            @foreach (System.Data.DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["Cliente_ID"]</td>
                    <td>@row["Nombre"]</td>
                    <td>@row["Telefono"]</td>
                    <td>@row["Email"]</td>
                    <td>
                        <a href="/Recepcionista/RegistrarPC?clienteId=@row["Cliente_ID"]"
                           class="btn btn-success btn-sm">
                            Seleccionar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<script>
    document.getElementById("buscador").addEventListener("keyup", function () {
        var filtro = this.value.toLowerCase();
        document.querySelectorAll("#tabla tr").forEach(function (fila) {
            fila.style.display = fila.innerText.toLowerCase().includes(filtro)
                ? ""
                : "none";
        });
    });
</script>
