@model System.Data.DataTable

@section Styles {
    <style>
        .form-card {
            max-width: 900px;
            margin: 20px auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 25px 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

            .form-card h2 {
                text-align: center;
                font-weight: 700;
                margin-bottom: 20px;
            }

        .btn-volver-small {
            padding: 6px 10px;
            font-size: 0.85rem;
        }

        #table-wrapper {
            overflow-x: auto;
        }

        table.table {
            min-width: 720px;
        }
    </style>
}

@functions {
    // Helper: devuelve el primer valor disponible entre varios nombres de columna
    private string GetRowValue(System.Data.DataRow row, params string[] possibleNames)
    {
        if (row == null || row.Table == null) return string.Empty;
        foreach (var name in possibleNames)
        {
            if (row.Table.Columns.Contains(name))
            {
                var val = row[name];
                if (val != null && val != System.DBNull.Value) return val.ToString();
            }
        }
        return string.Empty;
    }
}

<div class="form-card">

    <h2>Seleccionar Computadora</h2>

    <!-- Botón Volver pequeño -->
    <div class="d-flex mb-3">
        <a href="/Recepcionista/CrearSolicitud" class="btn btn-secondary btn-volver-small">Volver</a>
    </div>

    <div id="table-wrapper">
        <table class="table table-striped table-bordered mt-2">
            <thead>
                <tr>
                    <th>ID PC</th>
                    <th>Marca</th>
                    <th>Tipo</th>
                    <th>Cliente</th>
                    <th>Descripción</th>
                    <th>Acción</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Rows != null && Model.Rows.Count > 0)
                {
                    foreach (System.Data.DataRow row in Model.Rows)
                    {
                        <tr>
                            <!-- Usamos GetRowValue para evitar excepciones si la columna no existe -->
                            <td>@GetRowValue(row, "PC_ID", "Id", "Id_PC")</td>
                            <td>@GetRowValue(row, "Marca", "Marca_PC", "Brand")</td>
                            <td>@GetRowValue(row, "Tipo_computadora", "Tipo", "Type")</td>
                            <td>@GetRowValue(row, "Cliente", "Nombre", "Nombre_Cliente", "Cliente_Nombre")</td>
                            <td>@GetRowValue(row, "Descripcion", "Descripcion_problema", "ProblemDescription")</td>
                            <td>
                                @{
                                    // Construimos el PC id para la ruta de forma segura
                                    var pcId = GetRowValue(row, "PC_ID", "Id", "Id_PC");
                                }
                                @if (!string.IsNullOrEmpty(pcId))
                                {
                                    <a href="/Recepcionista/CrearSolicitud?pcId=@pcId" class="btn btn-success btn-sm">Seleccionar</a>
                                }
                                else
                                {
                                    <span class="text-muted small">Sin ID</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay computadoras para mostrar.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <script>
        // (Opcional) mejor manejo si planeas agregar buscador más tarde
        // Aquí no añadimos buscador para evitar conflictos con otras vistas
    </script>
}

